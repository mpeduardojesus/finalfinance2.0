# Copiar para .env e preencher. NÃO fazer commit do .env.
# Se ORACLE_HOST (ou ORACLE_SERVICE/ORACLE_USER) estiver vazio, a app usa os ficheiros JSON em data/ (modo demo).
ORACLE_HOST=
ORACLE_PORT=1521
ORACLE_SERVICE=
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_CHARSET=AL32UTF8
APP_DEBUG=0

# Plano de tesouraria (/treasury e /api/treasury/*): HTTP Basic. Se qualquer uma estiver vazia, o acesso é RECUSADO (503).
# Use uma palavra-passe longa e única; sirva a app atrás de HTTPS (o Basic viaja em claro em HTTP).
TREASURY_USER=
TREASURY_PASSWORD=
