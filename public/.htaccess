DirectoryIndex index.php
RewriteEngine On
# Ficheiros estáticos existentes são servidos diretamente; o resto vai para o front controller
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L,QSA]
# Garantir que o cabeçalho Authorization/Content-Type chega ao PHP
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Garantir que o cabeçalho Authorization (HTTP Basic) chega ao PHP também em CGI/FPM
SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1
